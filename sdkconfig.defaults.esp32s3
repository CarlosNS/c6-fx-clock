# ESP32-S3 (Waveshare ESP32-S3-Touch-AMOLED-2.06). ESP-IDF applies this file after
# sdkconfig.defaults when building for the S3; the C6 never reads it.
# PlatformIO only notices changes to sdkconfig.defaults: after editing this file, delete
# sdkconfig.s3amoled so it is generated again.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 32 MB GigaDevice quad flash. The CPU can only map the first 16 MB without experimental options,
# so the app partitions stay below that line (partitions_s3.csv)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_s3.csv"

# 8 MB octal PSRAM: framebuffers and big buffers go there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Wi-Fi and Bluetooth run together on this board: their buffers, NimBLE's memory and the TLS
# buffers (HTTPS: weather, updates) go to PSRAM to keep internal RAM free
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Not set: the 64 KB data cache (CONFIG_ESP32S3_DATA_CACHE_64KB, with 32 or 64 B lines) hangs this
# board right after the bootloader hands over to the app (ESP-IDF 5.5.0, tried 2026-11-07)
