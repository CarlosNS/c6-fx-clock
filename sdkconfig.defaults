# PlatformIO only notices changes to this file when sdkconfig.s3amoled is older: after editing it,
# delete sdkconfig.s3amoled so it is generated again.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Internal RAM is what runs short (Wi-Fi + Bluetooth + display strips): keep Wi-Fi / lwIP / FreeRTOS
# code in flash so the internal heap stays free
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
# Fewer fixed Wi-Fi receive buffers (10 -> 6, 1.6 KB each): commands and OTA uploads don't need more
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# OTA: a freshly updated firmware must confirm itself (ota_confirm_app) or the bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bluetooth (ble.c): NimBLE peripheral only, one connection
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# The BLE controller code runs from flash instead of taking ~29 KB of internal RAM (slower radio
# timing, fine for short commands and status messages)
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
# NimBLE logs two lines per notification at INFO: keep the serial console readable
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# microSD (app_files.c): long file names, kept on the heap
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ---- ESP32-S3 board ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 32 MB GigaDevice quad flash. The CPU can only map the first 16 MB without experimental options,
# so the app partitions stay below that line (partitions.csv)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# 8 MB octal PSRAM: framebuffers and big buffers go there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Wi-Fi and Bluetooth run together on this board: their buffers, NimBLE's memory and the TLS
# buffers (HTTPS: weather, updates) go to PSRAM to keep internal RAM free
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Not set: the 64 KB data cache (CONFIG_ESP32S3_DATA_CACHE_64KB, with 32 or 64 B lines) hangs this
# board right after the bootloader hands over to the app (ESP-IDF 5.5.0, tried 2026-11-07)

# USB disk mode (usbdisk.c): TinyUSB mass storage only, with the watch's own names
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Marea"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Marea"
CONFIG_TINYUSB_DESC_MSC_STRING="Marea microSD"

# Battery: CPU frequency scaling (main.c, esp_pm_configure)
CONFIG_PM_ENABLE=y
# Light sleep with the screen off (main.c light_sleep_allow): tickless idle, and Bluetooth in modem
# sleep so the link survives it. No 32 kHz crystal on the ESP32-S3 side: the controller keeps the main
# crystal powered during light sleep (a little more current, but the timing stays exact)
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
# Time spent in each power mode, for the "pm" console command
CONFIG_PM_PROFILING=y
# ...but without the options that put the sleep code and the CPU retention buffers in internal RAM:
# together they took ~60 KB of it, and internal RAM is what this firmware runs short of
CONFIG_PM_SLP_IRAM_OPT=n
CONFIG_PM_RTOS_IDLE_OPT=n
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n
# Big static arrays marked EXT_RAM_BSS_ATTR (face grids, buffers) live in PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
